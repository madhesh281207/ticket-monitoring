# Chennai: Avengers: Doomsday — Nexus Vijaya Mall IMAX
# Copy this file to .env and replace the ntfy topic with a long random value.
# Never commit .env. It is excluded by the project's .gitignore.

TARGET_DATE=2026-12-17
FORMAT_LABEL=IMAX
NTFY_TOPIC=REPLACE_WITH_A_LONG_RANDOM_NTFY_TOPIC
NTFY_URL=https://ntfy.sh

# BookMyShow
BMS_EVENT_CODE=ET00439706
BMS_REGION_CODE=CHN
BMS_REGION_SLUG=chennai
BMS_LAT=13.0827
BMS_LNG=80.2707
BMS_VENUE_CODE=PVPZ
BMS_FORMAT_MATCH=IMAX
BMS_BOOKING_URL=https://in.bookmyshow.com/cinemas/chennai/pvr-palazzo-the-nexus-vijaya-mall/buytickets/PVPZ/20261217

# District is intentionally not enabled yet: the exact movie content ID is not verified.
# Do not use the District cinema page's CD... identifier as the movie content ID.

PROVIDERS=bookmyshow
CHECK_INTERVAL_SECONDS=300
FAILURE_THRESHOLD=6
TZ_OFFSET_MINUTES=330
HEARTBEAT_HOUR=9
CURRENCY=₹
STATE_PATH=./state.json
PORT=4733
